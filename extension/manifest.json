{
  "manifest_version": 3,
  "name": "Claude 用量儀表",
  "version": "4.1.0",
  "description": "在 claude.ai 顯示 5 小時用量、重置倒數、消耗速率與暫停建議",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
